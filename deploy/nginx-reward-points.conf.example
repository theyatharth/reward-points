# Nginx reverse proxy for the reward-points app, on the same EC2 instance
# as your other Shopify app (which already answers on shopify.platinuminfo.tech).
# Using rewards.platinuminfo.tech here — swap it (in this file AND in
# shopify.app.toml) if you'd rather use a different subdomain.
#
# 1. Copy this file to /etc/nginx/sites-available/reward-points.conf on the box.
# 2. Point rewards.platinuminfo.tech's DNS A record at this EC2 instance's
#    public IP (same IP your other app already uses, since it's the same box).
# 3. Enable it:
#      sudo ln -s /etc/nginx/sites-available/reward-points.conf /etc/nginx/sites-enabled/
#      sudo nginx -t && sudo systemctl reload nginx
# 4. Get a TLS cert (this also rewrites this file to add the 443 server
#    block and cert paths automatically — you don't need to add SSL directives
#    yourself):
#      sudo certbot --nginx -d rewards.platinuminfo.tech

server {
    listen 80;
    server_name rewards.platinuminfo.tech;

    location / {
        proxy_pass http://127.0.0.1:3001;  # must match PORT in deploy/ecosystem.config.cjs
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

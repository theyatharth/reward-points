{% comment %}
  Rewards page, restyled to the client's prototype (rewardsScreen): balance card, owed and pending cards, codes ready to use,
  ONE reward card for the shop's single rule (every whole reward the points buy becomes one code), the progress to the next
  reward, ways to earn, and the activity timeline. Everything below the title is drawn by assets/rewards-client.js from the
  signed App Proxy /history call (createElement and textContent only); styles come from assets/rewards-theme.css (the
  prototype's own, scoped under .ecr). The proxy path is a block setting (dev app: /apps/rewards-dev).
{% endcomment %}
{% assign proxy_path = block.settings.proxy_path | default: '/apps/reward-points' %}
{% comment %} The program's name as the merchant set it (the rule metafield the app keeps in sync); "Reward Points" if it cannot be read. Once the customer's data loads, the page heading is set from the live value. {% endcomment %}
{% assign program_name = app.metafields.rewards.redeem_rule.value.programName | default: 'Reward Points' %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Nunito:wght@600;700;800&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&family=JetBrains+Mono:wght@400;500&display=swap">
{{ 'rewards-theme.css' | asset_url | stylesheet_tag }}

<div class="ecr ecr-page" id="ecrPage" data-proxy="{{ proxy_path | escape }}" data-logged-in="{% if customer %}true{% else %}false{% endif %}" data-shop-url="{{ routes.all_products_collection_url | escape }}">
  {% if customer %}
    <div class="rw-title"><span class="eyebrow">Shop. Grow. Get rewarded.</span><h1 id="ecrTitle">{{ program_name | escape }}</h1><p>Welcome back, {{ customer.first_name | escape }}</p></div>
    <div id="ecrBody" class="grid"><p class="muted">Loading your rewards…</p></div>
    <div id="ecrMessage" role="status" aria-live="polite"></div>
  {% else %}
    <div class="rw-title"><span class="eyebrow">Shop. Grow. Get rewarded.</span><h1 id="ecrTitle">{{ program_name | escape }}</h1><p>Join free and earn on every eligible order.</p></div>
    <section class="zero">
      <h2>Earn points on every order</h2>
      <p class="muted">Create an account to start earning points for every purchase, get reward codes, and unlock special perks.</p>
      <a class="btn" href="{{ routes.account_login_url | escape }}">Log In / Create Account</a>
    </section>
  {% endif %}
</div>

<script src="{{ 'rewards-client.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var E = window.EcoRewards;
    var root = document.getElementById('ecrPage');
    if (!E || !root || root.getAttribute('data-logged-in') !== 'true') return;
    E.initPage({
      body: document.getElementById('ecrBody'),
      message: document.getElementById('ecrMessage'),
      title: document.getElementById('ecrTitle'),
      proxyPath: root.getAttribute('data-proxy'),
      shopUrl: root.getAttribute('data-shop-url'),
    });
  });
</script>

{% schema %}
{
  "name": "Rewards Page Dashboard",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/reward-points",
      "info": "Where this app answers on the storefront: /apps/reward-points for the public app, /apps/rewards-dev for the development app."
    }
  ]
}
{% endschema %}

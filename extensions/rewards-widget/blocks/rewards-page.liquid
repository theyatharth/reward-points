{% comment %}
  Rewards page. First paint from the customer metafields and the shop rule metafield (see rewards-widget.liquid);
  the signed App Proxy /history call then fills in the live balances, the rule, the codes and the history.
  The proxy path is a block setting (dev app: /apps/rewards-dev). Every customer-controlled or server value is
  escaped in Liquid or written with textContent; nothing is built as HTML in script.
{% endcomment %}
{% assign proxy_path = block.settings.proxy_path | default: '/apps/rewards' %}
{% assign rule = app.metafields.rewards.redeem_rule.value %}
{% assign redeem_threshold = rule.pointsPerReward | default: 0 | plus: 0 %}

<div class="rp-container" id="rpRoot" data-proxy="{{ proxy_path | escape }}" data-logged-in="{% if customer %}true{% else %}false{% endif %}">
  {% if customer %}
    {% assign current_points = customer.metafields.custom.reward_points.value | default: 0 | plus: 0 %}
    {% assign pending_points = customer.metafields.custom.pending_points.value | default: 0 | plus: 0 %}
    {% assign pending_available_at = customer.metafields.custom.pending_points_available_at.value | default: blank %}
    {% assign discount_code = customer.metafields.custom.earned_discount_code.value | default: blank %}

    <!-- 1. Hero Section -->
    <div class="rp-hero">
      <div class="rp-hero-content">
        <h2>Welcome back, {{ customer.first_name | escape }}! 👋</h2>
        <p>You're earning exclusive perks with every purchase.</p>
      </div>
      <div class="rp-hero-balance">
        <span class="rp-balance-label">Available Balance</span>
        <div class="rp-balance-value"><span id="rpBalance">{{ current_points }}</span> <span class="rp-pts">PTS</span></div>
      </div>
    </div>

    <div class="rp-pending-banner" id="rpPending" {% unless pending_points > 0 %}hidden{% endunless %}>
      ⏳ <strong id="rpPendingText">{{ pending_points }} points pending</strong>
      <span id="rpPendingDate">{% if pending_available_at != blank and pending_available_at != 'NONE' %} — available on {{ pending_available_at | date: "%B %d, %Y" }}{% endif %}</span>
      <span class="rp-pending-sub" id="rpHoldText"></span>
    </div>
    <div class="rp-owed-banner" id="rpOwed" hidden></div>

    <!-- 2. Main Dashboard Grid -->
    <div class="rp-grid">

      <!-- Left Column: Active Rewards / Redeem -->
      <div class="rp-card rp-active-rewards">
        <div class="rp-card-header">
          <h3>🎟️ Your Active Rewards</h3>
        </div>
        <div class="rp-card-body">
          <p class="rp-reward-instruction" id="rpCodeHint" {% if discount_code == blank or discount_code == 'NONE' %}hidden{% endif %}>You have an active reward! Use this code at checkout.</p>
          <div class="rp-coupon-list" id="rpCodes">
            {% if discount_code != blank and discount_code != 'NONE' %}
              <div class="rp-coupon-box">
                <span class="rp-coupon-code">{{ discount_code | escape }}</span>
                <button class="rp-copy-btn" type="button" data-copy="{{ discount_code | escape }}">Copy</button>
              </div>
            {% endif %}
          </div>
          <div id="rpCopyMsg" class="rp-copy-msg"></div>

          <div class="rp-progress-section">
            <p class="rp-progress-label" id="rpProgressLabel">
              {% if redeem_threshold > 0 %}
                {% if current_points >= redeem_threshold %}🎉 You have enough points to redeem a reward!{% else %}<strong>{{ redeem_threshold | minus: current_points }} more points</strong> until your next reward{% endif %}
              {% else %}
                Checking your rewards…
              {% endif %}
            </p>
            <div class="rp-progress-track">
              {% if redeem_threshold > 0 %}
                {% assign pct = current_points | times: 100 | divided_by: redeem_threshold %}
                {% if pct > 100 %}{% assign pct = 100 %}{% endif %}
              {% else %}
                {% assign pct = 0 %}
              {% endif %}
              <div class="rp-progress-fill" id="rpProgressFill" style="width: {{ pct }}%;"></div>
            </div>
            <div class="rp-progress-meta">
              <span>0 pts</span>
              <span id="rpProgressMeta">{% if redeem_threshold > 0 %}{{ current_points }} / {{ redeem_threshold }} pts{% endif %}</span>
            </div>
          </div>

          <button class="rp-btn-redeem rp-btn-disabled" id="rpRedeemBtn" type="button" disabled>Redeem My Points</button>
          <div id="rpRedeemMsg" class="rp-redeem-msg" aria-live="polite"></div>
        </div>
      </div>

      <!-- Right Column: How to Earn -->
      <div class="rp-card">
        <div class="rp-card-header">
          <h3>⭐ How to Earn Points</h3>
        </div>
        <div class="rp-card-body">
          <ul class="rp-earn-list">
            <li>
              <div class="rp-earn-icon">🛍️</div>
              <div class="rp-earn-text">
                <strong>Make a Purchase</strong>
                <span>Earn points automatically on every paid order.</span>
              </div>
              <div class="rp-earn-reward">+Points</div>
            </li>
            <li>
              <div class="rp-earn-icon">🎁</div>
              <div class="rp-earn-text">
                <strong>Special Bonuses</strong>
                <span>Our team occasionally awards bonus points to loyal customers.</span>
              </div>
              <div class="rp-earn-reward">Varies</div>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 3. Reward History (from the ledger, through the App Proxy) -->
    <div class="rp-card rp-history-section">
      <div class="rp-card-header">
        <h3>🕰️ Reward History</h3>
        <p class="rp-header-sub">Your recent point activity and redemptions.</p>
      </div>
      <div class="rp-table-responsive" id="rpHistoryContainer">
        <div class="rp-loading">Loading history…</div>
      </div>
    </div>

  {% else %}
    <!-- Logged Out State -->
    <div class="rp-hero rp-logged-out-hero">
      <div class="rp-hero-content" style="text-align: center; width: 100%;">
        <h2>Join Our Rewards Program 🎁</h2>
        <p>
          Create an account today to start earning points for every purchase,
          get exclusive discount codes, and unlock special perks.
        </p>
        <a href="{{ routes.account_login_url }}" class="rp-btn-primary">
          Log In / Create Account
        </a>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .rp-container {
    max-width: 1000px;
    margin: 40px auto;
    padding: 0 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #1a1a1a;
  }

  /* Hero */
  .rp-hero {
    background: linear-gradient(135deg, #111 0%, #333 100%);
    border-radius: 16px;
    padding: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #fff;
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
    margin-bottom: 28px;
  }
  .rp-hero-content h2 { margin: 0 0 8px 0; font-size: 30px; color: #fff; }
  .rp-hero-content p { margin: 0; font-size: 15px; opacity: 0.8; }
  .rp-hero-balance {
    background: rgba(255,255,255,0.12);
    padding: 20px 28px;
    border-radius: 12px;
    text-align: right;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.2);
  }
  .rp-balance-label { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7; margin-bottom: 4px; }
  .rp-balance-value { font-size: 46px; font-weight: 800; line-height: 1; }
  .rp-pts { font-size: 18px; font-weight: 600; opacity: 0.75; }

  /* Grid */
  .rp-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 24px; margin-bottom: 24px; }
  @media (max-width: 768px) {
    .rp-hero { flex-direction: column; text-align: center; gap: 20px; }
    .rp-hero-balance { text-align: center; width: 100%; box-sizing: border-box; }
    .rp-grid { grid-template-columns: 1fr; }
  }

  /* Cards */
  .rp-card { background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid #f0f0f0; overflow: hidden; }
  .rp-card-header { background: #fafafa; padding: 18px 22px; border-bottom: 1px solid #f0f0f0; }
  .rp-card-header h3 { margin: 0; font-size: 17px; font-weight: 700; color: #111; }
  .rp-header-sub { margin: 4px 0 0 0; font-size: 13px; color: #888; }
  .rp-card-body { padding: 22px; }

  /* Progress Bar */
  .rp-progress-section { margin-bottom: 18px; }
  .rp-progress-label { font-size: 14px; color: #444; margin: 0 0 10px 0; }
  .rp-progress-label.rp-progress-ready { color: #2e7d32; font-weight: 600; }
  .rp-progress-track { background: #edf2f7; border-radius: 10px; height: 10px; overflow: hidden; margin-bottom: 6px; }
  .rp-progress-fill { background: linear-gradient(90deg, #111 0%, #555 100%); height: 100%; border-radius: 10px; transition: width 0.6s ease; }
  .rp-progress-meta { display: flex; justify-content: space-between; font-size: 12px; color: #999; }

  /* Redeem Button */
  .rp-btn-redeem {
    width: 100%; padding: 14px;
    background: #111; color: #fff;
    border: none; border-radius: 12px;
    font-size: 15px; font-weight: 600;
    cursor: pointer; transition: all 0.2s;
    margin-top: 4px;
  }
  .rp-btn-redeem:hover { background: #333; transform: translateY(-2px); }
  .rp-btn-disabled { opacity: 0.45; cursor: not-allowed; }
  .rp-btn-disabled:hover { background: #111; transform: none; }

  /* Redeem message */
  .rp-redeem-msg {
    margin-top: 12px; font-size: 13px;
    font-weight: 600; text-align: center;
    border-radius: 8px; padding: 0;
    transition: all 0.3s;
  }
  .rp-redeem-msg.success { background: #e8f5e9; color: #2e7d32; padding: 10px; }
  .rp-redeem-msg.error { background: #ffebee; color: #c62828; padding: 10px; }

  /* Active Coupon */
  .rp-reward-instruction { margin: 0 0 14px 0; font-size: 14px; color: #444; }
  .rp-coupon-box {
    background: #fdfbf7; border: 2px dashed #c8b87a;
    padding: 18px; border-radius: 12px;
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 10px;
  }
  .rp-coupon-code { font-size: 22px; font-weight: 800; letter-spacing: 2px; color: #111; }
  .rp-copy-btn {
    background: #111; color: #fff; border: none;
    padding: 9px 16px; border-radius: 8px;
    font-weight: 600; cursor: pointer; transition: background 0.2s;
  }
  .rp-copy-btn:hover { background: #333; }
  .rp-copy-btn.copied { background: #2e7d32; }
  .rp-copy-msg { font-size: 12px; color: #2e7d32; font-weight: 600; min-height: 16px; text-align: center; }

  /* Earn List */
  .rp-earn-list { list-style: none; padding: 0; margin: 0; }
  .rp-earn-list li { display: flex; align-items: center; padding: 16px 0; border-bottom: 1px solid #f0f0f0; gap: 14px; }
  .rp-earn-list li:last-child { border-bottom: none; padding-bottom: 0; }
  .rp-earn-icon { font-size: 26px; background: #f5f5f5; width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; border-radius: 12px; flex-shrink: 0; }
  .rp-earn-text { flex: 1; }
  .rp-earn-text strong { display: block; font-size: 14px; margin-bottom: 3px; }
  .rp-earn-text span { font-size: 12px; color: #888; display: block; }
  .rp-earn-reward { font-weight: 700; color: #2e7d32; background: #e8f5e9; padding: 5px 10px; border-radius: 20px; font-size: 13px; white-space: nowrap; }

  /* History Table */
  .rp-history-section { margin-top: 0; }
  .rp-table-responsive { overflow-x: auto; }
  .rp-history-table { width: 100%; border-collapse: collapse; text-align: left; }
  .rp-history-table th { background: #fff; padding: 14px 22px; font-size: 12px; text-transform: uppercase; color: #888; border-bottom: 2px solid #f0f0f0; }
  .rp-history-table td { padding: 14px 22px; border-bottom: 1px solid #f0f0f0; font-size: 13px; color: #333; }
  .rp-history-table tr:last-child td { border-bottom: none; }
  .rp-points-plus { color: #2e7d32; font-weight: 700; text-align: right; }
  .rp-points-minus { color: #d32f2f; font-weight: 700; text-align: right; }
  .rp-badge { padding: 3px 9px; border-radius: 12px; font-size: 11px; font-weight: 600; }
  .rp-badge-success { background: #e8f5e9; color: #2e7d32; }
  .rp-badge-neutral { background: #f5f5f5; color: #666; }
  .rp-loading { text-align: center; padding: 40px; color: #999; font-size: 14px; }


  /* Logged Out */
  .rp-logged-out-hero { flex-direction: column; padding: 60px 20px; }
  .rp-btn-primary {
    display: inline-block; background: #fff; color: #111;
    padding: 16px 32px; text-decoration: none;
    border-radius: 30px; font-weight: 700; margin-top: 24px;
    transition: transform 0.2s;
  }
  .rp-btn-primary:hover { transform: translateY(-2px); }

    .rp-pending-banner {
    background: #fff8e1;
    border: 1px solid #ffe082;
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 24px;
    font-size: 14px;
    color: #7a5c00;
  }
  .rp-pending-sub { display: block; font-size: 12px; color: #9c7a1a; margin-top: 4px; }
  [hidden] { display: none !important; }
  .rp-coupon-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 10px; }
  .rp-owed-banner { background: #fdecea; border: 1px solid #f5c6c2; border-radius: 12px; padding: 14px 18px; margin-bottom: 24px; font-size: 14px; color: #8a1f17; }
</style>
<script src="{{ 'rewards-client.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var E = window.EcoRewards;
    var root = document.getElementById('rpRoot');
    if (!E || !root || root.getAttribute('data-logged-in') !== 'true') return;
    var proxyPath = E.safeProxyPath(root.getAttribute('data-proxy'));

    var msg = document.getElementById('rpRedeemMsg');
    function say(text, type) { msg.className = 'rp-redeem-msg ' + type; msg.textContent = text; }

    function copyMsg(text) {
      var el = document.getElementById('rpCopyMsg');
      el.textContent = text;
      setTimeout(function () { el.textContent = ''; }, 2500);
    }
    function wireCopy(btn, code) {
      btn.addEventListener('click', function () {
        E.copyText(code, function () { btn.textContent = '✓ Copied!'; btn.classList.add('copied'); copyMsg('Code copied to clipboard!');
          setTimeout(function () { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2500); },
          function () { copyMsg('Could not copy: ' + code); });
      });
    }
    var codes = document.getElementById('rpCodes');
    Array.prototype.forEach.call(codes.querySelectorAll('[data-copy]'), function (btn) { wireCopy(btn, btn.getAttribute('data-copy')); });

    function apply(view) {
      var b = view.balance;
      document.getElementById('rpBalance').textContent = String(b.available);

      var pending = document.getElementById('rpPending');
      pending.hidden = !(b.pending > 0);
      document.getElementById('rpPendingText').textContent = b.pending + ' points pending';
      var first = view.pending && view.pending[0];
      document.getElementById('rpPendingDate').textContent = first ? ' — available on ' + E.formatDate(first.availableOn) : '';
      // The hold period comes from the rule, never a literal.
      document.getElementById('rpHoldText').textContent = view.rule && view.rule.holdPeriodDays > 0
        ? 'New orders hold points for ' + view.rule.holdPeriodDays + ' days before they\'re spendable, to keep the rewards program fair for everyone.' : '';

      var owed = document.getElementById('rpOwed');
      owed.hidden = !(b.owed > 0);
      owed.textContent = b.owed > 0 ? b.owed + ' points from a returned order are being recovered. New points will clear this first; rewards are paused until then.' : '';

      E.clear(codes);
      (view.rewards || []).forEach(function (r) {
        var box = E.h('div', 'rp-coupon-box');
        box.appendChild(E.h('span', 'rp-coupon-code', r.code));
        var btn = E.h('button', 'rp-copy-btn', 'Copy');
        btn.type = 'button';
        wireCopy(btn, r.code);
        box.appendChild(btn);
        codes.appendChild(box);
      });
      document.getElementById('rpCodeHint').hidden = !(view.rewards && view.rewards.length);

      var p = E.progress(view);
      var label = document.getElementById('rpProgressLabel');
      if (!p.known) label.textContent = 'Checking your rewards…';
      else if (p.ready) label.textContent = '🎉 You have enough points to redeem a reward!';
      else { label.textContent = ''; label.appendChild(E.h('strong', null, p.needed + ' more points')); label.appendChild(document.createTextNode(' until your next reward')); }
      label.className = 'rp-progress-label' + (p.ready ? ' rp-progress-ready' : '');
      document.getElementById('rpProgressFill').style.width = p.pct + '%';
      document.getElementById('rpProgressMeta').textContent = p.known ? b.available + ' / ' + view.rule.pointsPerReward + ' pts' : '';

      var btnRedeem = document.getElementById('rpRedeemBtn');
      var can = p.known && p.ready && !(b.owed > 0);
      btnRedeem.disabled = !can;
      btnRedeem.classList.toggle('rp-btn-disabled', !can);
      btnRedeem.textContent = can ? 'Redeem My Points' : (b.owed > 0 ? 'Rewards paused' : p.known ? 'Need ' + view.rule.pointsPerReward + ' Points to Redeem' : 'Redeem My Points');

      var cls = { table: 'rp-history-table', plus: 'rp-points-plus', minus: 'rp-points-minus' };
      E.renderHistory(document.getElementById('rpHistoryContainer'), view.history, cls);
    }

    var latest = null;
    function refresh() {
      return E.loadView(proxyPath).then(function (res) {
        if (res.ok && res.body && res.body.success) { latest = res.body; apply(res.body); }
        else throw new Error('bad answer');
      }).catch(function () {
        var c = document.getElementById('rpHistoryContainer');
        if (!latest) { E.clear(c); c.appendChild(E.h('div', 'rp-loading', 'Your history could not be loaded right now.')); }
      });
    }

    var redeemer = E.createRedeemer({ proxyPath: proxyPath });
    var busy = false;
    document.getElementById('rpRedeemBtn').addEventListener('click', function (e) {
      e.preventDefault();
      if (busy) return;
      busy = true;
      var btn = e.currentTarget;
      btn.disabled = true;
      btn.textContent = 'Generating Code…';
      redeemer.run().then(function (r) {
        busy = false;
        if (r.kind === 'success') { say('🎉 Your discount code: ' + r.body.code, 'success'); return refresh(); }
        if (r.kind === 'creating') { say('Your reward is being prepared. It will appear here in a moment.', 'success'); setTimeout(refresh, 3000); setTimeout(refresh, 9000); return refresh(); }
        say(r.kind === 'network' ? 'Network error. Please try again.' : (r.body.message || 'Failed to redeem. Please try again.'), 'error');
        return latest ? apply(latest) : refresh();
      });
    });

    refresh();
  });
</script>

{% schema %}
{
  "name": "Rewards Page Dashboard",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/rewards",
      "info": "Where this app answers on the storefront: /apps/rewards for the live app, /apps/rewards-dev for the development app."
    }
  ]
}
{% endschema %}

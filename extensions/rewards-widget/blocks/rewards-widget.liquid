{% comment %}
  Floating rewards widget, restyled to the client's prototype (widgetView): a pill button ("N pts") that opens a small panel
  with the balance, its value, the progress to the next reward, pending points and a link to the Rewards page.
  First paint: the label from the synced customer metafield custom.reward_points. As soon as the page loads, the signed App Proxy
  /history call draws the live numbers (the ledger is the truth, the metafield is a cache). The proxy path is a block setting
  (dev app: /apps/rewards-dev). All markup that depends on data is built by assets/rewards-client.js with createElement and
  textContent; styles come from assets/rewards-theme.css (the prototype's own, scoped under .ecr).
{% endcomment %}
{% assign proxy_path = block.settings.proxy_path | default: '/apps/reward-points' %}
{% assign program_name = app.metafields.rewards.redeem_rule.value.programName | default: 'Reward Points' %}
{% assign side = block.settings.side | default: 'right' %}
{% assign rewards_page = block.settings.rewards_page_url | default: '/pages/rewards' %}
{% assign label = 'Rewards' %}
{% if customer %}
  {% assign points = customer.metafields.custom.reward_points.value | default: 0 | plus: 0 %}
  {% if points > 0 %}{% capture label %}{{ points }} pts{% endcapture %}{% endif %}
{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Nunito:wght@600;700;800&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap">
{{ 'rewards-theme.css' | asset_url | stylesheet_tag }}

<div class="ecr ecr-widget side-{{ side | escape }}" id="ecrWidget"
     data-proxy="{{ proxy_path | escape }}" data-program="{{ program_name | escape }}" data-logged-in="{% if customer %}true{% else %}false{% endif %}"
     data-shop-url="{{ routes.all_products_collection_url | escape }}" data-page-url="{{ rewards_page | escape }}" data-login-url="{{ routes.account_login_url | escape }}">
  <div class="wpanel" id="ecrPanel" role="dialog" aria-label="Your rewards" hidden></div>
  <button class="wbtn" id="ecrToggle" type="button" aria-expanded="false" aria-controls="ecrPanel">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9Z"/><path d="M3 7h18v4H3z"/><path d="M12 7v14"/><path d="M12 7c-1.5-3-5-3.5-5-1.2C7 7 9.5 7 12 7Zm0 0c1.5-3 5-3.5 5-1.2C17 7 14.5 7 12 7Z"/></svg>
    <span class="num" id="ecrLabel">{{ label | escape }}</span>
    <span class="dot" id="ecrDot" hidden></span>
  </button>
</div>

<script src="{{ 'rewards-client.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var E = window.EcoRewards;
    var root = document.getElementById('ecrWidget');
    if (!E || !root) return;
    var widget = E.initWidget({
      toggle: document.getElementById('ecrToggle'),
      label: document.getElementById('ecrLabel'),
      dot: document.getElementById('ecrDot'),
      panel: document.getElementById('ecrPanel'),
      proxyPath: root.getAttribute('data-proxy'),
      loggedIn: root.getAttribute('data-logged-in') === 'true',
      programName: root.getAttribute('data-program'),
      shopUrl: root.getAttribute('data-shop-url'),
      pageUrl: root.getAttribute('data-page-url'),
      loginUrl: root.getAttribute('data-login-url'),
    });
    document.addEventListener('click', function (e) { if (!root.contains(e.target)) widget.setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') widget.setOpen(false); });
  });
</script>

{% schema %}
{
  "name": "Floating Rewards Widget",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/reward-points",
      "info": "Where this app answers on the storefront: /apps/reward-points for the public app, /apps/rewards-dev for the development app."
    },
    {
      "type": "select",
      "id": "side",
      "label": "Side of the screen",
      "default": "right",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ]
    },
    {
      "type": "text",
      "id": "rewards_page_url",
      "label": "Rewards page path",
      "default": "/pages/rewards",
      "info": "Where the \"View Rewards\" button goes (a path on this store)."
    }
  ]
}
{% endschema %}

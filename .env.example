# =============================================================================
# DATABASE — AWS PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
# =============================================================================
DATABASE_URL=

# Test database (name MUST end in _test).
# Never set this to a database that doesn't end in _test — the test runner
# refuses to start if the database name does not match that requirement.
TEST_DATABASE_URL=

# Comma-separated list of database names that scripts and tests must refuse
# to connect to (e.g. the live production database).
# Example: PROTECTED_DATABASES=reward_points
PROTECTED_DATABASES=

# =============================================================================
# SHOPIFY — Filled automatically by `shopify app dev` during development,
# or set manually for production.
# =============================================================================
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# =============================================================================
# SERVER
# =============================================================================
BACKEND_PORT=
HOST=

# =============================================================================
# APP — Base path for routing (determines cookie path, Vite base, proxy/redirect
# URLs). Use /reward-points in production, /reward-points-dev in development.
# =============================================================================
APP_BASE_PATH=
